{
  "info": {"name":"Orbit ERP API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Core ERP/CRM API flow. Run Login first; the JWT is saved automatically."},
  "variable": [{"key":"BASE_URL","value":"http://localhost:4000/api"},{"key":"TOKEN","value":""},{"key":"baseUrl","value":"http://localhost:4000/api"},{"key":"token","value":""},{"key":"customerId","value":""},{"key":"productId","value":""},{"key":"challanId","value":""}],
  "item": [
    {"name":"Authentication","item":[
      {"name":"Login","event":[{"listen":"test","script":{"exec":["const body = pm.response.json();","pm.collectionVariables.set('TOKEN', body.data.token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"admin@orbit.local\",\n  \"password\": \"Orbit@123\"\n}"},"url":"{{BASE_URL}}/auth/login"}},
      {"name":"Current user","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{TOKEN}}"}],"url":"{{BASE_URL}}/auth/me"}}
